# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local example: mongodb://127.0.0.1:27017/guraneza
# Atlas example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/guraneza
MONGO_URI=mongodb+srv://kennedy:kennedy1234@cluster0.didlxxa.mongodb.net/

# JWT signing secret. Use a long random value in production (set it in Render,
# never commit it). JWTs expire using UTC time by default.
JWT_SECRET=00833be4a2952de135b1600a277036ac54e7ea1ad018a250e39541eaf69911f9
JWT_EXPIRES_IN=30d

# Frontend origins allowed by CORS (comma-separated).
CLIENT_URL=http://localhost:5173,https://guraneza-ja1a.onrender.com

# Default administrator credentials created by the seed script
ADMIN_EMAIL=admin@guraneza.rw
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=GuraNeza Admin
