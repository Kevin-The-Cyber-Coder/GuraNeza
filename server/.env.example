# ---------------------------------------------------------------------------
# GuraNeza API — environment template
# Copy to server/.env and fill in real values. NEVER commit server/.env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string (replica set required for transactions).
# Local:  mongodb://127.0.0.1:27017/guraneza
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/guraneza
MONGO_URI=mongodb://127.0.0.1:27017/guraneza

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Public URLs
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Seed administrator (used only by the seed script)
ADMIN_EMAIL=admin@guraneza.rw
ADMIN_PASSWORD=change-me-before-seeding
ADMIN_NAME=GuraNeza Admin

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=GuraNeza <onboarding@resend.dev>

# Seller invitation lifetime (hours)
SELLER_INVITE_TTL_HOURS=72

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_MB=5
