            ],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Verifies the JWT from the Login request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"success is true\", function () { pm.expect(pm.response.json().success).to.be.true; });",
                  "pm.test(\"User email is correct\", function () { pm.expect(pm.response.json().user.email).to.eql(\"admin@guraneza.rw\"); });"
                ]
              }
            }
          ]
        },
